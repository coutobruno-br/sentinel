# ===========================================
# Sentinel Engine - Environment Configuration
# ===========================================

# Server
PORT=3000
NODE_ENV=development

# ===========================================
# GitHub App Configuration
# ===========================================
# Get these values from your GitHub App settings:
# https://github.com/settings/apps/YOUR_APP_NAME

# App ID (numeric)
GITHUB_APP_ID=

# Private key (PEM format, can be base64 encoded)
# Generate at: GitHub App Settings > Private keys > Generate
GITHUB_PRIVATE_KEY=

# Webhook secret (random string for HMAC validation)
# Set at: GitHub App Settings > Webhook > Secret
GITHUB_WEBHOOK_SECRET=

# ===========================================
# Billing / Marketplace
# ===========================================
BILLING_PROVIDER=paddle
TRIAL_EXECUTION_LIMIT=50

# ===========================================
# Paddle Configuration (Sandbox)
# ===========================================
# Get these from: https://sandbox-vendors.paddle.com/authentication
# For production: https://vendors.paddle.com/authentication

# API Key for server-side operations
PADDLE_API_KEY=

# Client-side token for Paddle.js (checkout modal)
PADDLE_CLIENT_TOKEN=

# Webhook secret for signature verification
PADDLE_WEBHOOK_SECRET=

# Environment: sandbox or production
PADDLE_ENVIRONMENT=sandbox

# Price IDs for each plan (create in Paddle dashboard)
PADDLE_PRICE_ID_PRO=
PADDLE_PRICE_ID_ENTERPRISE=

# ===========================================
# Persistence
# ===========================================
# SQLite database path (default: sentinel.db)
DATABASE_PATH=sentinel.db

# ===========================================
# API Security
# ===========================================
# Comma-separated list of valid API keys
SENTINEL_API_KEYS=key_dev_123,key_readonly_456

# ===========================================
# Evidence Signing
# ===========================================
# RSA private key for evidence signing (PEM format)
# If not set, uses development mode (HMAC)
PRIVATE_SIGNING_KEY=

# Evidence storage directory
EVIDENCE_DIR=evidence

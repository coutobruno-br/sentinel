# ===========================================
# Sentinel Engine - Environment Configuration
# ===========================================

# Server
PORT=3000
NODE_ENV=development

# ===========================================
# GitHub App Configuration
# ===========================================
# Get these values from your GitHub App settings:
# https://github.com/settings/apps/YOUR_APP_NAME

# App ID (numeric)
GITHUB_APP_ID=

# Private key (PEM format, can be base64 encoded)
# Generate at: GitHub App Settings > Private keys > Generate
GITHUB_PRIVATE_KEY=

# Webhook secret (random string for HMAC validation)
# Set at: GitHub App Settings > Webhook > Secret
GITHUB_WEBHOOK_SECRET=

# ===========================================
# Billing / Marketplace
# ===========================================
BILLING_PROVIDER=github
TRIAL_EXECUTION_LIMIT=50

# ===========================================
# Persistence
# ===========================================
# SQLite database path (default: sentinel.db)
DATABASE_PATH=sentinel.db

# ===========================================
# API Security
# ===========================================
# Comma-separated list of valid API keys
SENTINEL_API_KEYS=key_dev_123,key_readonly_456

# ===========================================
# Evidence Signing
# ===========================================
# RSA private key for evidence signing (PEM format)
# If not set, uses development mode (HMAC)
PRIVATE_SIGNING_KEY=

# Evidence storage directory
EVIDENCE_DIR=evidence

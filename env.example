# .env.example

```
# Server
PORT=3000
NODE_ENV=development

# GitHub App
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Billing / Marketplace
BILLING_PROVIDER=github
TRIAL_EXECUTION_LIMIT=50

# Persistence
DATABASE_URL=

// .env.example (add)
# API Security
SENTINEL_API_KEYS=key_dev_123,key_readonly_456

// .env.example (add)
# Evidence
EVIDENCE_DIR=evidence


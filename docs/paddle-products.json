  "webhook_endpoints": [
    {
      "description": "Sentinel Production Webhook",
      "destination": "https://api.sentinel-engine.com/webhook/paddle",
      "subscribed_events": [
        "subscription.created",
        "subscription.updated",
        "subscription.canceled",
        "subscription.paused",
        "subscription.resumed",
        "subscription.activated",
        "transaction.completed",
        "transaction.payment_failed"
      ]
    }
  ],
  "setup_instructions": {
    "step_1": "Go to Paddle Dashboard > Catalog > Products",
    "step_2": "Create each product from the 'products' array above",
    "step_3": "For each product, go to Prices and create prices from the 'prices' array",
    "step_4": "Copy the Price IDs (pri_...) and add to your .env file",
    "step_5": "Go to Developer Tools > Notifications and create the webhook endpoint",
    "step_6": "Copy the Webhook Secret and add to PADDLE_WEBHOOK_SECRET in .env",
    "env_example": {
      "PADDLE_API_KEY": "pdl_sdbx_xxx (from Developer Tools > Authentication)",
      "PADDLE_CLIENT_TOKEN": "test_xxx (from Developer Tools > Authentication > Client-side tokens)",
      "PADDLE_WEBHOOK_SECRET": "pdl_ntfset_xxx (from webhook notification settings)",
      "PADDLE_PRICE_ID_PRO": "pri_xxx (Monthly Pro price ID)",
      "PADDLE_PRICE_ID_ENTERPRISE": "pri_xxx (Monthly Enterprise price ID)",
      "PADDLE_ENVIRONMENT": "sandbox"
    }
  }

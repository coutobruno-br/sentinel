{
  "name": "sentinel-engine",
  "version": "0.1.0",
  "description": "Sentinel — Policy-as-Code Audit Engine",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "dist/sentinel/server.js",
  "types": "dist/server.d.ts",
  "bin": {
    "sentinel-check": "./dist/sentinel/cli/index.js"
  },
  "scripts": {
    "check": "tsx ./src/sentinel/cli/index.ts",
    "check:staged": "tsx ./src/sentinel/cli/index.ts --staged",
    "check:all": "tsx ./src/sentinel/cli/index.ts --all",
    "dev": "cross-env NODE_ENV=development tsx watch ./src/sentinel/server.ts",
    "dev:landing": "http-server landing -p 8080 -c-1 -o",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:landing\"",
    "start": "cross-env NODE_ENV=production node ./dist/sentinel/server.js",
    "start:dev": "cross-env NODE_ENV=development node ./dist/sentinel/server.js",
    "build": "tsc",
    "lint": "eslint .",
    "test": "vitest",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@paddle/paddle-node-sdk": "^3.5.0",
    "better-sqlite3": "^12.5.0",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.19.2",
    "uuid": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.8.0",
    "http-server": "^14.1.1",
    "tsx": "^4.15.7",
    "typescript": "^5.5.4",
    "vitest": "^4.0.16"
  }
}

# ===========================================
# Sentinel Engine - Production Environment
# ===========================================

NODE_ENV=production
PORT=3000

# ===========================================
# URLs (Update with your actual domain)
# ===========================================
API_URL=https://api.sentinel-engine.com
LANDING_URL=https://sentinel-engine.com

# ===========================================
# GitHub App (Production)
# ===========================================
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ===========================================
# Paddle Production
# ===========================================
PADDLE_ENVIRONMENT=production
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID_PRO=
PADDLE_PRICE_ID_ENTERPRISE=

# ===========================================
# Database
# ===========================================
DATABASE_PATH=/app/data/sentinel.db

# ===========================================
# API Security
# ===========================================
SENTINEL_API_KEYS=

# ===========================================
# Evidence Signing (RSA in production)
# ===========================================
PRIVATE_SIGNING_KEY=
EVIDENCE_DIR=/app/data/evidence
